    <string name="kb_gboard_step1_title">Open Gboard settings</string>
    <string name="kb_gboard_step1_body">In any app, long-press the comma key on Gboard, then tap the gear icon.</string>
    <string name="kb_gboard_step2_title">Find Voice typing</string>
    <string name="kb_gboard_step2_body">Tap Voice typing inside Gboard settings.</string>
    <string name="kb_gboard_step3_title">Pick recognizer</string>
    <string name="kb_gboard_step3_body">Choose Yiddish VTT as the speech recognizer.</string>
    <string name="kb_gboard_step4_title">Test it</string>
    <string name="kb_gboard_step4_body">Open any text field, tap the mic on Gboard, and speak in Yiddish.</string>

    <string name="kb_samsung_step1_title">Open Samsung Keyboard settings</string>
    <string name="kb_samsung_step1_body">Settings → General management → Samsung Keyboard settings.</string>
    <string name="kb_samsung_step2_title">Voice input</string>
    <string name="kb_samsung_step2_body">Tap Voice input and choose Yiddish VTT.</string>
    <string name="kb_samsung_step3_title">Test it</string>
    <string name="kb_samsung_step3_body">Open any text field, tap the mic on the keyboard, and speak in Yiddish.</string>

    <string name="kb_swiftkey_step1_title">Open SwiftKey settings</string>
    <string name="kb_swiftkey_step1_body">Long-press the comma key, then tap the SwiftKey gear icon.</string>
    <string name="kb_swiftkey_step2_title">Voice &amp; speech</string>
    <string name="kb_swiftkey_step2_body">Find the speech-to-text option and pick Yiddish VTT.</string>
    <string name="kb_swiftkey_step3_title">Test it</string>
    <string name="kb_swiftkey_step3_body">Open any text field, tap the mic, and speak in Yiddish.</string>

    <string name="kb_other_step1_title">Open keyboard settings</string>
    <string name="kb_other_step1_body">Tap the button below to open Android\'s keyboard settings, then look for a Voice typing or Speech recognizer option in your keyboard.</string>
    <string name="kb_other_step2_title">Pick Yiddish VTT</string>
    <string name="kb_other_step2_body">Choose Yiddish VTT wherever your keyboard lets you select a speech recognizer.</string>

