<resources>
    <style name="Theme.YiddishVTT" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/heimish_primary</item>
        <item name="colorPrimaryVariant">@color/heimish_primary_container</item>
        <item name="colorOnPrimary">@color/heimish_on_primary</item>
        <item name="colorSecondary">@color/heimish_secondary</item>
        <item name="colorSecondaryVariant">@color/heimish_secondary_container</item>
        <item name="colorOnSecondary">@color/heimish_on_primary</item>
        <item name="android:windowBackground">@color/heimish_surface</item>
        <item name="colorSurface">@color/heimish_surface_container_lowest</item>
        <item name="colorOnSurface">@color/heimish_on_surface</item>
        <item name="colorError">@color/heimish_error</item>
        <item name="colorOnError">@color/heimish_on_error</item>
        <item name="android:statusBarColor">@color/heimish_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/heimish_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="SettingsRowButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textColor">@color/heimish_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@null</item>
        <item name="iconTint">@color/heimish_primary</item>
        <item name="iconGravity">textEnd</item>
    </style>
</resources>
