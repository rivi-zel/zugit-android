<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/micContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/floatingMicButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_button"
            android:src="@drawable/ic_mic"
            android:padding="14dp"
            android:tint="@color/heimish_secondary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/mic_content_description" />

        <ProgressBar
            android:id="@+id/pbMicLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="10dp"
            android:indeterminateTint="@color/heimish_secondary"
            style="?android:attr/progressBarStyleSmall" />

        <LinearLayout
            android:id="@+id/recordingIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_recording_indicator"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/mic_stop_description">

            <View
                android:id="@+id/recBar1"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_recording_bar" />
            <View
                android:id="@+id/recBar2"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_recording_bar" />
            <View
                android:id="@+id/recBar3"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_recording_bar" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvMicStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/heimish_on_surface"
        android:textAppearance="@style/TextAppearance.Heimish.LabelCaps"
        android:visibility="gone"
        android:elevation="10dp" />

    <TextView
        android:id="@+id/tvCoachTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="64dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_heimish_pill_gold"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/floating_drag_hint"
        android:textColor="@color/heimish_on_secondary_container"
        android:textAppearance="@style/TextAppearance.Heimish.LabelUi"
        android:elevation="12dp"
        android:visibility="gone" />

</FrameLayout>
